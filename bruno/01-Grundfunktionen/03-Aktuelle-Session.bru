tests {
  test("Admin ist angemeldet", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().authenticated).to.equal(true);
    expect(res.getBody().user.username).to.equal(bru.getEnvVar("adminUsername"));
  });
}
