meta {
  name: Testkunde aendern
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/datenbanken/kunden/{{crudKundeId}}
  body: json
  auth: none
}

body:json {
  {
    "segment": "API-Test aktualisiert"
  }
}

tests {
  test("Die Kundenaenderung wurde gespeichert", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().item.segment).to.equal("API-Test aktualisiert");
  });
}
