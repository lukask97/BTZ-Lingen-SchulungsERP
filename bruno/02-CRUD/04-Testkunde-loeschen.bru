meta {
  name: Testkunde loeschen
  type: http
  seq: 4
}

script:pre-request {
  if (!bru.hasVar("crudKundeId") && !bru.getEnvVar("crudKundeId")) {
    bru.runner.skipRequest();
  }
}

delete {
  url: {{baseUrl}}/api/datenbanken/kunden/{{crudKundeId}}
  body: none
  auth: none
}

tests {
  test("Der Testkunde wurde geloescht", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().ok).to.equal(true);
  });
}
