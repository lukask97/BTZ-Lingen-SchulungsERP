meta {
  name: Demoklasse auswaehlen
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/active-class
  body: json
  auth: none
}

body:json {
  {
    "klasseId": 0
  }
}

tests {
  test("Demo-Klasse ist fuer Persistenztests aktiv", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().authenticated).to.equal(true);
    expect(String(res.getBody().user.activeClass.id)).to.equal("0");
  });
}
